{
  "name": "pomo-doro-tui",
  "version": "1.16.0",
  "description": "pomodoro tui app",
  "license": "ISC",
  "author": "dandrok",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dandrok/pomo_doro.git"
  },
  "homepage": "https://github.com/dandrok/pomo_doro#readme",
  "bugs": {
    "url": "https://github.com/dandrok/pomo_doro/issues"
  },
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "pomo": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "pomodoro",
    "timer",
    "tui",
    "ink",
    "cli",
    "productivity"
  ],
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "dev:test": "NODE_ENV=test tsx src/cli.tsx",
    "build": "tsup src/cli.tsx --format esm --clean --minify --target esnext",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "conf": "^16.0.0",
    "ink": "^8.0.0",
    "ink-big-text": "^2.0.0",
    "ink-select-input": "^6.2.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
