# VHS Tape for pomo-doro-tui
Output assets/demo.gif

Set FontSize 14
Set Width 920
Set Height 600
Set Padding 12
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful

Type "pomo"
Enter
Sleep 1.5s

# Select "Start" from Main Menu
Enter
Sleep 1s

# Select "25min" Preset
Enter
Sleep 1s

# Start the Focus Session
Enter
Sleep 3s

# Open Contextual Help Overlay
Type "h"
Sleep 2.5s

# Dismiss Help Overlay
Type "h"
Sleep 1.5s

# Demonstrate Pause & Resume
Type "p"
Sleep 1.5s
Type "p"
Sleep 1.5s

# Demonstrate Instant Skip to Break
Type "s"
Sleep 3s

# Return to Main Menu
Escape
Sleep 1.5s

# Navigate to History Dashboard
Down 2
Sleep 800ms
Enter
Sleep 3.5s

# Return to Main Menu
Escape
Sleep 1.5s

# Navigate to Exit
Down 5
Sleep 800ms
Enter
Sleep 1.5s
